# --- Secrets: never commit ---
.env
.env.*
*.pem
*.key
*.keystore
id_rsa*
credentials*

# --- Third-party mining input: raw clones of other teams' PUBLIC repos (reproducible; not a
#     deliverable; also carries their FTC debug keystores). The distilled corpus ships in the plugin. ---
corpus-sources/

# --- OS / editor / tool caches ---
.DS_Store
__pycache__/
*.pyc
.impeccable/

# --- Packaged build artifacts (rebuilt from source) ---
*.skill

# --- Stray third-party team code (not part of the Refract deliverable; same rationale as corpus-sources) ---
32008teamcode/

# --- Team 19859's own real robot code repo, if/when present alongside this project (its own nested
#     .git; carries a debug keystore) -- not part of the Refract deliverable, never swept into a
#     git add -A here regardless of whose code it is. ---
19859crucialcodeauthentic/

# --- Gradle build output/cache from compile-testing the quickstart-template or a real TeamCode
